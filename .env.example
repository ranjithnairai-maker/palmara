# --- OpenRouter (server-side only) ---
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any vision/multimodal-capable model id from https://openrouter.ai/models (filter: image input).
# Default is free + multimodal. Swap to a paid model later with no code changes.
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl:free

# --- Supabase ---
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Service role key (Project Settings -> API -> service_role). SERVER-SIDE ONLY. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional ---
# Canonical origin for building absolute share links. Falls back to the request host if unset.
NEXT_PUBLIC_SITE_URL=
# Salts the IP hash used by lib/rateLimit.ts. Any random string; safe default if unset.
RATE_LIMIT_SALT=
# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when it
# triggers /api/cron/prune-images. Set this in Vercel too so the retention
# job can't be triggered by anyone who finds the URL. Any random string.
CRON_SECRET=
# Shown in the footer as a fallback for anyone who lost the browser that
# created a reading (so lost the delete control) and needs it removed
# manually. Omit to hide that line entirely.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Support / tips (Stripe Payment Links, plain outbound URLs — no
# checkout code, no webhooks, no payment data ever touches this app) ---
# Create three one-time Payment Links in the Stripe Dashboard ($1/$3/$5)
# and paste the resulting URLs here. The tip strip only renders if at
# least one of these is set.
NEXT_PUBLIC_TIP_LINK_1=
NEXT_PUBLIC_TIP_LINK_3=
NEXT_PUBLIC_TIP_LINK_5=

# --- Ebook ($1 "Learn Palmistry Basics" PDF, real Stripe Checkout + webhook
# this time, unlike the tip links above — see CLAUDE.md for the full setup
# walkthrough and why a webhook, not the success redirect, is what actually
# confirms payment) ---
# Secret key from the Stripe Dashboard (Developers -> API keys). SERVER-SIDE ONLY.
STRIPE_SECRET_KEY=
# The id of a one-time $1 USD Price object (Product catalog -> your ebook
# product -> the Price's API ID, starts with "price_"). NOT a Payment Link.
STRIPE_EBOOK_PRICE_ID=
# Signing secret for the webhook endpoint (Developers -> Webhooks -> your
# endpoint -> Signing secret, starts with "whsec_"). Register the endpoint
# at <your-site>/api/stripe/webhook, subscribed to checkout.session.completed,
# checkout.session.async_payment_succeeded, and checkout.session.async_payment_failed.
STRIPE_WEBHOOK_SECRET=
